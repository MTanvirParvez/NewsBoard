# ╔════════════════════════════════════════════════════╗
# ║   LuminaBoard — Environment Variables              ║
# ║   Copy to .env.local — ALL keys are OPTIONAL!      ║
# ║   The app works out of the box with zero keys.     ║
# ╚════════════════════════════════════════════════════╝

# ─── App URL (auto-detected, only set if needed) ────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (OPTIONAL — for auth & data persistence) ────
# Without these, the app uses localStorage only (fully functional)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── News APIs (OPTIONAL — RSS feeds are the default) ────
# RSS feeds from BBC, Reuters, NYT, etc. work with zero keys.
# Add these for additional sources:
# NEWSDATA_API_KEY=your-newsdata-io-key       # newsdata.io — 200 credits/day free
# NEWSAPI_API_KEY=your-newsapi-org-key         # newsapi.org — 100 req/day free

# ─── AI APIs (OPTIONAL — local AI engine is the default) ────
# Local engine: extractive summaries + keyword sentiment (zero cost)
# Add ONE of these for LLM-powered summaries & chat:
# OPENAI_API_KEY=your-openai-key               # GPT-4o-mini (cheapest)
# XAI_API_KEY=your-xai-grok-key                # Grok via xAI
# ANTHROPIC_API_KEY=your-anthropic-key          # Claude Haiku
